# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (ancien nom accepté : NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Claude (paramètres et documents du CPS, lecture du bordereau, création de modèles) — côté serveur uniquement, ne jamais préfixer par NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-xxx

# Taille maximale d'un fichier déposé, en Mo (facultatif, 50 par défaut).
# À aligner sur le bucket « scans » et sur la limite globale du projet Supabase.
# NEXT_PUBLIC_TAILLE_MAX_MO=50
